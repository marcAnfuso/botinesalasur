# ===========================================
# CONFIGURACIÓN DE BOTINESALA SUR
# ===========================================
# Copia este archivo a .env.local y completá los valores

# ===========================================
# SUPABASE
# ===========================================
# Encontrás estos valores en: https://supabase.com/dashboard/project/[tu-proyecto]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Esta key es secreta, solo para el servidor (API routes)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ===========================================
# MERCADOPAGO
# ===========================================
# Encontrás estos valores en: https://www.mercadopago.com.ar/developers/panel
# Primero creá una aplicación y usá las credenciales de TEST para probar
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxx-xxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxx-xxxxx

# URL base de tu sitio (para los callbacks de MercadoPago)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ===========================================
# ADMIN
# ===========================================
# Contraseña para el panel de administración (cambiar en producción!)
ADMIN_PASSWORD=botinesalasur2024
